# Python sources are formatted with Ruff and stored with one canonical newline.
*.py text eol=lf

# Golden and archive fixtures record exported bytes. Git must never rewrite
# their line endings, or the comparison would depend on the checkout platform.
tests/contract/golden/** -text
tests/contract/golden/**/*.csv whitespace=cr-at-eol
tests/contract/fixtures/** -text whitespace=cr-at-eol
